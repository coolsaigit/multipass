{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/__init__.py": true,
        "**/*pycache*": true,
        "**/.pytest_cache": true
    },
    "hide-files.files": [],
    "files.associations": {
        "*.tf": "terraform",
        "*.tfvars": "terraform",
        "*.hcl": "terraform"
      },
      "terraform.enableLanguageServer": true,
      "terraform.format.enable": true,
      "terraform.languageServer": {
        "external": true
      },
      "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true
      }
}